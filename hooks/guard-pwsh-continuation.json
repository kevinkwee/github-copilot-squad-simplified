{
    "version": 1,
    "hooks": {
        "PreToolUse": [
            {
                "type": "command",
                "matcher": "Bash",
                "powershell": "pwsh -NoProfile -ExecutionPolicy Bypass -File C:/Users/YOUR-PROFILE/.copilot/scripts/guard-pwsh-continuation/guard-pwsh-continuation.ps1",
                "bash": "exit 0",
                "timeout": 10
            }
        ]
    }
}